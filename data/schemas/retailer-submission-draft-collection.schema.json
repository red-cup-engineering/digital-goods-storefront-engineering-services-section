{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/ns/retailer-submission-draft-collection/v2",
  "title": "Retalier submission drafts derived from source-qualified ebook catalog; not a publisher receipt",
  "description": "A source-authored Shop compiled catalog projected through the reusable Red Cup retailer form producer into publisher-review candidates. This machine resource records no submission, platform entitlement, acceptance or sale.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordKind",
    "schemaVersion",
    "disposition",
    "sourceCatalog",
    "bookSubmissionDrafts"
  ],
  "properties": {
    "recordKind": {
      "const": "retailer-submission-draft-collection"
    },
    "schemaVersion": {
      "const": 2
    },
    "disposition": {
      "const": "proposed-not-submitted"
    },
    "sourceCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "contentDigest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_\\-.]*\\.mjs$",
          "not": {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          }
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "bookSubmissionDrafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bookOfferingId",
          "bookTitle",
          "retailerSubmissionDrafts"
        ],
        "properties": {
          "bookOfferingId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "bookTitle": {
            "type": "string",
            "minLength": 1
          },
          "retailerSubmissionDrafts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "retailerCode",
                "retailerName",
                "proposedSubmissionFields",
                "submissionBlockers",
                "operatorReviewNotes",
                "disposition"
              ],
              "properties": {
                "retailerCode": {
                  "enum": [
                    "kdp",
                    "kdp-paperback",
                    "kobo",
                    "google-play-books",
                    "apple-books",
                    "barnes-noble-press",
                    "leanpub"
                  ]
                },
                "retailerName": {
                  "type": "string",
                  "minLength": 1
                },
                "proposedSubmissionFields": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "author",
                    "publisher",
                    "language",
                    "description",
                    "subjects",
                    "listPriceUsd",
                    "files",
                    "cover"
                  ],
                  "properties": {
                    "author": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bleed": {
                      "type": "string",
                      "minLength": 1
                    },
                    "categories": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cover": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "drm": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expandedDistribution": {
                      "type": "string",
                      "minLength": 1
                    },
                    "finish": {
                      "type": "string",
                      "minLength": 1
                    },
                    "identifier": {
                      "type": "string",
                      "minLength": 1
                    },
                    "isbn": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kdpSelect": {
                      "type": "string",
                      "minLength": 1
                    },
                    "language": {
                      "type": "string",
                      "minLength": 1
                    },
                    "paper": {
                      "type": "string",
                      "minLength": 1
                    },
                    "publisher": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revenueSplit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "royalty": {
                      "type": "string",
                      "minLength": 1
                    },
                    "series": {
                      "type": "string",
                      "minLength": 1
                    },
                    "subseries": {
                      "type": "string",
                      "minLength": 1
                    },
                    "subtitle": {
                      "type": "string",
                      "minLength": 1
                    },
                    "territories": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "trim": {
                      "type": "string",
                      "minLength": 1
                    },
                    "aiUsage": {
                      "type": "string",
                      "minLength": 1
                    },
                    "listPriceUsd": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
                    },
                    "minimumPriceUsd": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
                    },
                    "suggestedPriceUsd": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
                    },
                    "contributors": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "keywords": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "subjects": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "aiDisclosure": {
                      "type": "object",
                      "required": [
                        "text",
                        "images",
                        "translations"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "images": {
                          "type": "string",
                          "minLength": 1
                        },
                        "translations": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "aiCategories": {
                      "type": "object",
                      "required": [
                        "manuscript",
                        "cover",
                        "images",
                        "translations"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "manuscript": {
                          "enum": [
                            "AI-Created",
                            "AI-Assisted",
                            "None"
                          ]
                        },
                        "cover": {
                          "enum": [
                            "AI-Created",
                            "AI-Assisted",
                            "None"
                          ]
                        },
                        "images": {
                          "enum": [
                            "AI-Created",
                            "AI-Assisted",
                            "None"
                          ]
                        },
                        "translations": {
                          "enum": [
                            "AI-Created",
                            "AI-Assisted",
                            "None"
                          ]
                        }
                      }
                    }
                  }
                },
                "submissionBlockers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "operatorReviewNotes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "disposition": {
                  "enum": [
                    "blocked",
                    "candidate-needs-publisher-review"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "disposition": {
                        "const": "blocked"
                      }
                    },
                    "required": [
                      "disposition"
                    ]
                  },
                  "then": {
                    "properties": {
                      "submissionBlockers": {
                        "minItems": 1
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "disposition": {
                        "const": "candidate-needs-publisher-review"
                      }
                    },
                    "required": [
                      "disposition"
                    ]
                  },
                  "then": {
                    "properties": {
                      "submissionBlockers": {
                        "maxItems": 0
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
